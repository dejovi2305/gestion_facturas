  <property name="styleSheet">
   <string notr="true">/* Estilo general (neutro) */
QDialog {
    background-color: #ffffff;
    font-family: 'Segoe UI', Arial, sans-serif;
    color: #2c3e50;
}

/* Títulos y etiquetas */
QLabel {
    font-size: 14px;
}

/* Campo de entrada */
QLineEdit {
    border: 1px solid #d1d5db;
    border-radius: 8px;
    padding: 10px 12px;
    font-size: 14px;
    background-color: #ffffff;
}
QLineEdit:hover { border-color: #bfc5d0; }
QLineEdit:focus { border: 2px solid #94a3b8; }

/* Botón primario */
QPushButton {
    background-color: #64748b; /* azul-gris neutro */
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 12px;
    font-size: 14px;
    font-weight: 600;
}
QPushButton:hover { background-color: #556176; }
QPushButton:pressed { background-color: #485567; }

/* Panel izquierdo */
#frame_left {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1,
        stop:0 #1e3a8a, stop:1 #3b82f6);
}

/* Avatar circular */
#label_3 {
    background-color: rgba(255,255,255,0.15);
    border-radius: 56px;
    border: 1px solid rgba(255,255,255,0.35);
    color: #ffffff;
    font-size: 48px;
    qproperty-alignment: AlignCenter;
}

/* Título de la derecha */
#label_title { font-size: 20px; font-weight: 700; }
#label_subtitle { color: #64748b; font-size: 12px; }
