  <property name="styleSheet">
   <string notr="true">/* Estilo general para la ventana de login */
QDialog {
    background-color: #f5f7fa;
    font-family: 'Segoe UI', Arial, sans-serif;
}

/* Estilo para los QLabel */
QLabel {
    color: #2c3e50;
    font-size: 14px;
    font-weight: bold;
    margin-bottom: 5px;
}

QLabel {

}

/* Estilo para los QLineEdit */
QLineEdit {
    border: 1px solid #d1d5db;
    border-radius: 6px;
    padding: 10px;
    font-size: 14px;
    background-color: white;
    selection-background-color: #3b82f6;
    margin-bottom: 15px;
}

/* Estilo base para los campos de entrada */
QLineEdit {
    border: 2px solid #d1d5db;
    border-radius: 8px;
    padding: 12px;
    font-size: 14px;
    background-color: white;
    transition: all 0.3s ease; /* Transición suave */
    margin-bottom: 15px;
}

/* Efecto hover - resaltado azul */
QLineEdit:hover {
    border: 2px solid #3b82f6;
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2); /* Sombra difuminada azul */
}

/* Efecto cuando el campo está enfocado */
QLineEdit:focus {
    border: 2px solid #3b82f6;
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.3);
}

/* Estilo especial para el campo de contraseña */
QLineEdit[echoMode=&quot;2&quot;] {
    font-family: 'Courier New';
    letter-spacing: 2px;
}

/* Estilo para el QPushButton */
QPushButton {
    background-color: #3b82f6;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 12px 20px;
    font-size: 14px;
    font-weight: bold;
    margin-top: 10px;
}

QPushButton:hover {
    background-color: #2563eb;
}

QPushButton:pressed {
    background-color: #1d4ed8;
}

/* Estilo para el QMessageBox */
QMessageBox {
    background-color: #f5f7fa;
}

QMessageBox QLabel {
    color: #2c3e50;
    font-size: 14px;
}

QMessageBox QPushButton {
    min-width: 80px;
    padding: 8px 16px;
}</string>
